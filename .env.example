# ===== 报告模板（已选定：⑭ 时尚大片 THE POOL）=====
# 其他可选: classic/terminal/editorial/newspaper/imperial/pastel/swiss/
#           focus/letter/dashboard/changelog/brew/readme/journal/zen/neon/arcade/luxe/infographic
REPORT_TEMPLATE=vogue

# ===== Agnes AI（AI点评，选填；不填则输出纯规则报告）=====
# platform.agnes-ai.com 控制台生成
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# ===== 邮件 SMTP（必填才能发信）=====
# QQ邮箱: smtp.qq.com / 465  密码填"授权码"（设置→账户→开启SMTP→生成授权码）
# 163邮箱: smtp.163.com / 465 同上
# Gmail:   smtp.gmail.com / 465 密码填 App Password
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=your_auth_code
MAIL_TO=target@example.com
